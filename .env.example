# Copia este archivo como .env y ajusta lo que necesites.
# El archivo .env no se sube nunca al repositorio.

# Puerto en el que se publica la aplicación (si no usas Wall-O)
COMPELECTRIX_PUERTO=8000

# Con el portal Wall-O: quita la almohadilla de la línea siguiente.
# CompElectrix no publicará puerto propio, se dormirá sin uso y se entrará por el portal (puerto 8101).
# COMPOSE_FILE=docker-compose.yml:docker-compose.wallo.yml

# --- Próximas fases (aún no se usan) ---
# Clave de la API de Anthropic para leer facturas con IA (opcional)
# ANTHROPIC_API_KEY=
# Token de ESIOS de Red Eléctrica (opcional; el PVPC funcionará sin él)
# ESIOS_TOKEN=
